# Переменные окружения для docker compose.
# Файл .env создаёт ./deploy.sh автоматически; этот образец нужен для ручной настройки.
# Значения в .env не попадают в репозиторий (.gitignore).

# Внешний порт сервиса на машине завода
PORT=8000

# Токен для правки настроек с других компьютеров.
# Если пусто, панель настроек доступна только с самого сервера.
# ./deploy.sh создаёт токен автоматически и печатает его после запуска.
SILANT_ADMIN_TOKEN=

# 1 — разрешить правку настроек из локальной сети без токена.
# По умолчанию (пусто) без токена настройки доступны только с самого сервера:
# в Docker внешний запрос приходит с адреса bridge-сети и неотличим от внешнего.
SILANT_ADMIN_ALLOW_LAN=

# Файл индекса внутри контейнера
SILANT_DB=/app/data/index.sqlite3

# Дополнительные флаги сервера
SILANT_SERVER_ARGS=

# Ключ языковой модели. Сервис работает и без него: ответы остаются
# дословными цитатами из руководств.
SILANT_LLM_API_KEY=
SILANT_LLM_BASE_URL=
SILANT_LLM_MODEL=

# 1 — переиндексировать документы при старте контейнера, 0 — не трогать индекс
SILANT_AUTOINGEST=1
