{
  "app_name": "СИЛАНТ · Сервисный ассистент",
  "app_subtitle": "Ответы только по руководствам по эксплуатации ЧЗСА",
  "service_contacts": {
    "phone": "",
    "email": "",
    "site": "",
    "note": "Контакты сервисной службы ЧЗСА не указаны в переданных руководствах. Заполните телефон и почту в админ-панели (/admin.html) — сервис выведет их в ответе об отсутствии информации."
  },
  "thresholds": {
    "min_coverage": 0.42,
    "min_matched_terms": 2,
    "min_score": 0.3,
    "top_k": 8,
    "candidate_limit": 60
  },
  "clarification": {
    "model_required_patterns": [
      "через сколько",
      "периодичност",
      "интервал",
      "\\bто[123]\\b",
      "момент затяжк",
      "затяжк",
      "заправочн",
      "какое масло",
      "марк[аи] масл",
      "сколько литров",
      "объ[её]м",
      "охлаждающ",
      "аккумулятор",
      "\\bакб\\b",
      "батаре",
      "как часто",
      "наработк",
      "грузоподъ[её]мн",
      "грузоподъ[её]мность домкрата",
      "буксир",
      "транспортир",
      "давление в шинах",
      "заправк",
      "топлив"
    ]
  },
  "model_rules": {
    "parenthetical_exception_model": "ПД5,0"
  },
  "out_of_scope": {
    "groups": [
      {
        "any_of": [
          "двигател"
        ],
        "also_of": [
          "изготовител",
          "капитальн",
          "переборк",
          "расточк",
          "дефектовк",
          "запчаст"
        ],
        "reason": "engine_manufacturer",
        "message": "Это вопрос по документации изготовителя двигателя. Такой документ в базу не входит: в неё загружены только руководства по эксплуатации погрузчиков СИЛАНТ."
      },
      {
        "any_of": [
          "toyota",
          "тойота",
          "jungheinrich",
          "линде",
          "linde",
          "still",
          "хангча",
          "hangcha",
          "helix",
          "nissan",
          "komatsu",
          "cat",
          "caterpillar",
          "балканкар",
          "амкодор"
        ],
        "also_of": [],
        "reason": "other_brand",
        "message": "Вопрос относится к технике другого производителя. База содержит только руководства по эксплуатации погрузчиков СИЛАНТ (ЧЗСА), данные других марок к ним не применимы."
      }
    ]
  },
  "llm": {
    "enabled": false,
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4o-mini",
    "temperature": 0,
    "timeout_seconds": 40
  }
}
